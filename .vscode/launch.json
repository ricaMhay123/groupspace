{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 Start GroupSpace Server",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/server.js",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "🌐 Launch Chrome against GroupSpace",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/public"
    }
  ],
  "compounds": [
    {
      "name": "⚡ Full Stack (Server + Chrome)",
      "configurations": ["🚀 Start GroupSpace Server", "🌐 Launch Chrome against GroupSpace"],
      "stopAll": true
    }
  ]
}
